APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_NAME="Almaty Leads"

# Lead map / import settings
LEADS_CITY=Алматы
LEADS_MAP_CENTER_LAT=43.238949
LEADS_MAP_CENTER_LNG=76.945465
LEADS_MAP_ZOOM=12
# OpenFreeMap vector tiles (no API key). Swap for a licensed provider under load.
LEADS_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
LEADS_MAP_STYLE_URL_LIGHT=https://tiles.openfreemap.org/styles/positron
LEADS_SOURCE_DRIVER=parser2gis
LEADS_GEOCODER_DRIVER=null
LEADS_OUTREACH_DRIVER=null
# :name подставляется названием компании в первом сообщении WhatsApp
LEADS_WHATSAPP_TEMPLATE="Здравствуйте! Пишу по поводу :name — хочу предложить сайт и продвижение."

# Open-source Chrome parser: https://github.com/interlark/parser-2gis
# Install: python3 -m venv tools/parser-2gis/.venv && tools/parser-2gis/.venv/bin/pip install -r tools/parser-2gis/requirements.txt
# PARSER2GIS_BINARY=  # defaults to tools/parser-2gis/.venv/bin/parser-2gis
PARSER2GIS_CHROME_BINARY="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
PARSER2GIS_DOMAIN=kz
PARSER2GIS_CITY_SLUG=almaty
PARSER2GIS_MAX_RECORDS=50
PARSER2GIS_DELAY_MS=100
PARSER2GIS_HEADLESS=false
PARSER2GIS_PROCESS_TIMEOUT=3600
# CHATAGENTS_API_URL=
# CHATAGENTS_API_TOKEN=
